{
	"name": "p2p-chat-web-client",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.23.0",
	"engines": {
		"node": "26"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"test": "node test_call_views.mjs && node test_format_and_platform.mjs && node test_store.mjs && node test_live_server.mjs",
		"build": "vite build",
		"build:singlefile": "vite build --config vite.singlefile.config.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.0",
		"html-minifier-terser": "^7.2.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vite-plugin-singlefile": "^2.3.4"
	},
	"dependencies": {
		"@datf/cotilla-wasm": "^0.0.1"
	}
}
